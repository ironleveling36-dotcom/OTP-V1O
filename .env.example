# Copy this to .env and fill in your values
# On Railway: set these in the Variables tab (do NOT commit .env to git)

BOT_TOKEN=your_telegram_bot_token_here
OTP_API_KEY=

# ── Admin IDs (comma-separated) ────────────────────────────────────────────────
# Your Telegram numeric ID(s). Send /id to @userinfobot to discover yours.
ADMIN_IDS=123456789

# ── Gmail Auto-Verification (NEW) ─────────────────────────────────────────────
# If set, the bot will auto-verify wallet recharges by reading payment-alert
# emails from your Gmail via IMAP. If not set, falls back to manual admin approval.
#
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an app password: https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password (no spaces) below.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
# Optional: only look at emails FROM this address (your bank/UPI alert sender)
SENDER_FILTER=
# How many hours back to search for payment emails (default: 48)
EMAIL_LOOKBACK_HOURS=48

# ── Persistent storage (Railway) ──────────────────────────────────────────────
# The bot stores everything in a SQLite file. Railway's filesystem is
# EPHEMERAL, so you MUST attach a Volume or your data resets on every deploy.
#   1. Railway > your service > Volumes > add a volume, mount path: /data
#   2. Set the variable below so the DB lives on that volume:
DB_PATH=/data/bot.db
